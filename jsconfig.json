{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "node",
        "target": "ES2022",
        "types": ["node"],
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "maxNodeModuleJsDepth": 0
    },
    "include": ["webpack.config.mjs", "scripts/**/*.mjs", "test/**/*.mjs"],
    "exclude": ["node_modules", "dist", "src"]
}
